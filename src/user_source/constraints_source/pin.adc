# Slice 9 USB-TTL on VGA header (3.3V). Do not use onboard CH340 Type-C next to HDMI_B.
set_pin_assignment	{ uart_tx }	{ LOCATION = E7; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;} #VGA HS -> USB-TTL RXD
set_pin_assignment	{ uart_rx }	{ LOCATION = F7; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP;} #VGA VS <- USB-TTL TXD
set_pin_assignment	{ spk }	{ LOCATION = H11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;} #onboard piezo

# EC11 on J1 (GPIOA). Schematic J1 pin↔GPIOA_n; board-test P1IO[n]=GPIOA_n.
# CLK=H13=GPIOA_4=J1 pin5; DT=H14=GPIOA_5=J1 pin6; SW=J14=GPIOA_6=J1 pin7.
# GND=J1 pin12/30; VCC=J1 pin29 (3V3). Do NOT use pin11 (5V).
set_pin_assignment	{ enc_clk }	{ LOCATION = H13; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP;} #J1-5 GPIOA_4
set_pin_assignment	{ enc_dt }	{ LOCATION = H14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP;} #J1-6 GPIOA_5
set_pin_assignment	{ enc_sw }	{ LOCATION = J14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP;} #J1-7 GPIOA_6

# U33 W25X64 user SPI flash (not the bitstream flash)
set_pin_assignment	{ flash_cs }	{ LOCATION = P8; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP;}
set_pin_assignment	{ flash_sdo }	{ LOCATION = N8; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
set_pin_assignment	{ flash_wp }	{ LOCATION = P9; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;}
set_pin_assignment	{ flash_hold }	{ LOCATION = R9; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;}
set_pin_assignment	{ flash_sclk }	{ LOCATION = M9; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;}
set_pin_assignment	{ flash_sdi }	{ LOCATION = P7; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;}






